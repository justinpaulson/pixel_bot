<div class="sketchbook" data-controller="sketchbook" data-game-target="sketchbook" data-sketchbook-round-value="" hidden>
  <div class="sketchbook-heading">
    <div><h2 role="status">Pixel is drawing…</h2><p data-sketchbook-target="waitCopy">Usually about a minute. Your timer hasn’t started.</p></div>
    <span class="sketchbook-wait" data-sketchbook-target="elapsed" aria-label="Time spent waiting">0:00</span>
  </div>
  <div class="sketchbook-paper">
    <span class="sketchbook-label">PIXEL’S SKETCHBOOK</span>
    <svg class="sketchbook-art" viewBox="0 0 400 260" aria-hidden="true">
      <g data-sketchbook-target="art" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></g>
      <g data-sketchbook-target="pencil" visibility="hidden"><%= render "pencil" %></g>
    </svg>
    <span class="sketchbook-caption" data-sketchbook-target="caption"></span>
  </div>
  <div class="sketchbook-footer">
    <p>Warm-up doodles, not clues.</p>
    <button type="button" class="sketchbook-shuffle" data-action="sketchbook#next"><span aria-hidden="true">↻</span> New doodle</button>
  </div>
</div>

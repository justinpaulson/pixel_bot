<section class="hero">
  <h1>Pixel draws.<br><span class="hero-last">You guess.</span></h1>
  <div class="sample-card">
    <%= image_tag "sample-dinosaur.svg", alt: "Example drawing: a dinosaur and a tour vehicle", width: 512, height: 512 %>
  </div>
</section>

<section id="play" class="play-section">
  <div class="section-heading"><h2>Category</h2></div>
  <%= form_with url: games_path, class: "setup-form", data: { turbo: false } do |form| %>
    <fieldset class="category-picker">
      <legend class="sr-only">Choose a category</legend>
      <% @categories.each do |key, category| %>
        <label class="category-option <%= "mix-option" if key == "mix" %>">
          <%= radio_button_tag :category, key, key == "mix" %>
          <span class="category-icon" aria-hidden="true"><%= category[:icon] %></span>
          <span class="category-text"><strong><%= category[:name] %></strong></span><span class="category-check" aria-hidden="true">✓</span>
        </label>
      <% end %>
    </fieldset>
    <div class="game-setup">
      <div class="name-field"><%= label_tag :display_name, "Nickname" %><%= text_field_tag :display_name, Current.user&.display_name, maxlength: 24, autocomplete: "nickname" %></div>
      <div class="rounds-field"><%= label_tag :round_limit, "Rounds" %><%= select_tag :round_limit, options_for_select([3, 5, 10], 5) %></div>
      <div class="play-buttons"><button type="submit" name="mode" value="solo" class="button primary">Play solo <span aria-hidden="true">↗</span></button><button type="submit" name="mode" value="party" class="button secondary">Play with friends <span aria-hidden="true">＋</span></button></div>
    </div>
  <% end %>
</section>

<% if @game.edition != 2 %>
  <section class="welcome-card"><h1>This game has ended.</h1><%= link_to "New game", root_path, class: "button primary" %></section>
<% elsif !@member %>
  <section class="welcome-card">
    <% if @game.mode == "solo" || @game.completed? %>
      <h1><%= @game.completed? ? "Game over" : "Solo game" %></h1><%= link_to "New game", root_path, class: "button primary" %>
    <% else %>
      <h1>Join game</h1><p><%= PromptCatalog::CATEGORIES.fetch(@game.category)[:name] %></p>
      <%= form_with url: join_game_path(@game), data: { turbo: false } do |form| %><%= label_tag :display_name, "Nickname" %><%= text_field_tag :display_name, Current.user&.display_name, maxlength: 24, autocomplete: "nickname" %><%= form.submit "Join game", class: "button primary" %><% end %>
    <% end %>
  </section>
<% else %>
  <section class="game-room" data-controller="game" data-game-state-url-value="<%= state_game_path(@game) %>" data-game-base-url-value="<%= game_path(@game) %>">
    <div class="room-heading"><h1 data-game-target="heading">Pixel</h1><%= link_to "New game", root_path, class: "text-button" %></div>
    <p class="connection-message" data-game-target="connection" role="status"></p>
    <div class="room-grid">
      <div class="drawing-column">
        <div class="drawing-card">
          <div class="drawing-toolbar"><span class="category-pill" data-game-target="category"></span><span class="round-label" data-game-target="roundLabel"></span><span class="timer" data-game-target="timer" aria-label="Seconds remaining">—</span></div>
          <div class="canvas">
            <%= render "drawing" %>
            <div class="canvas-message" data-game-target="placeholder"><%= image_tag "favicon.svg", class: "drawing-mascot", alt: "", width: 105, height: 105 %><h2 data-game-target="canvasTitle">Loading…</h2><p data-game-target="canvasCopy"></p></div>
            <%= render "sketchbook" %>
          </div>
        </div>
        <div class="guess-area">
          <form data-game-target="guessForm" data-action="submit->game#guess" hidden>
            <label for="guess" class="sr-only">Your guess</label><div class="guess-input-row"><input id="guess" name="answer" data-game-target="guessInput" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="120" placeholder="Your guess" required><button class="button primary" data-game-target="guessButton">Guess <span aria-hidden="true">↵</span></button></div>
          </form>
          <p data-game-target="feedback" class="guess-feedback" role="status" aria-live="polite"></p>
          <p data-game-target="hint" class="hint" hidden></p>
          <div data-game-target="reveal" class="answer-reveal" hidden><span class="eyebrow">ANSWER</span><h2 data-game-target="answer"></h2><p class="next-round-countdown" data-game-target="nextCountdown" role="timer" aria-live="off" hidden></p></div>
        </div>
      </div>
      <aside class="room-sidebar">
        <section class="score-card"><div class="score-heading"><h2 data-game-target="scoreTitle">Scores</h2><span aria-hidden="true">✦</span></div><ol class="scoreboard" data-game-target="scoreboard"></ol></section>
        <% if @game.mode == "party" %>
          <section class="invite-card" aria-label="Invite friends"><label class="sr-only" for="invite-link">Invite link</label><input id="invite-link" data-game-target="shareUrl" value="<%= game_url(@game) %>" readonly><button class="button secondary" data-action="game#copyInvite" data-game-target="copyButton">Copy invite link</button></section>
        <% end %>
        <div class="host-controls">
          <button class="button primary full-width" data-game-target="startButton" data-action="game#start" hidden>Start game</button>
          <button class="button primary full-width" data-game-target="retryButton" data-action="game#retry" hidden>Retry drawing</button>
          <button class="text-button reveal-button" data-game-target="skipButton" data-action="game#skip" hidden>Reveal & end round</button>
          <p class="waiting-note" data-game-target="waitingNote"></p>
        </div>
        <%= link_to "Play again", root_path, class: "button primary full-width", data: { game_target: "againButton" }, hidden: true %>
      </aside>
    </div>
    <section class="gallery-section" data-game-target="gallerySection" hidden><div class="section-heading"><h2>Drawings</h2></div><div class="round-gallery" data-game-target="gallery"></div></section>
    <noscript><p class="flash">Enable JavaScript to play.</p></noscript>
  </section>
<% end %>

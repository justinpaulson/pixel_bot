<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Pixel — Guess the drawing" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A fresh drawing. A secret answer. A room full of guesses. Play Pixel solo or with friends, with movies, music, TV and more.">
    <meta name="theme-color" content="#f0f5f1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <%= link_to root_path, class: "brand", aria: { label: "Pixel home" } do %>
        <span class="brand-mark" aria-hidden="true">✳</span> pixel<span class="brand-period">.</span>
      <% end %>
      <nav aria-label="Main navigation">
        <% if Current.user %>
          <span class="user-name"><%= Current.user.name %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-button" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "text-button" %>
        <% end %>
      </nav>
    </header>
    <main id="main" class="page-shell">
      <% flash.each do |kind, message| %>
        <div class="flash <%= kind %>" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer"><a href="https://buy.stripe.com/9B600i4VY3Be3CT4AOfrW00" target="_blank" rel="noopener">Support Pixel</a></footer>
  </body>
</html>

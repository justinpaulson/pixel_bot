<!DOCTYPE html>
<html lang="en">
  <head>
    <% page_title = content_for(:title) || "Pixel — Guess the drawing" %>
    <% page_description = "A fresh drawing. A secret answer. A room full of guesses. Play Pixel solo or with friends, with movies, music, TV and more." %>
    <% social_image_url = "https://pixel.justinpaulson.com/og-image-v1.jpg" %>
    <% social_image_alt = "Pixel draws. You guess. A playful dinosaur sketch beside a mint pencil. Play solo or with friends." %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#f0f5f1">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Pixel">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= social_image_url %>">
    <meta property="og:image:secure_url" content="<%= social_image_url %>">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= social_image_alt %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= social_image_url %>">
    <meta name="twitter:image:alt" content="<%= social_image_alt %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag "favicon.svg", type: "image/svg+xml" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <%= link_to root_path, class: "brand", aria: { label: "Pixel home" } do %>
        <%= image_tag "favicon.svg", class: "brand-mark", alt: "", width: 43, height: 43 %> pixel<span class="brand-period">.</span>
      <% end %>
      <nav aria-label="Main navigation">
        <% if Current.user %>
          <span class="user-name"><%= Current.user.name %></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "text-button" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "text-button" %>
        <% end %>
      </nav>
    </header>
    <main id="main" class="page-shell">
      <% flash.each do |kind, message| %>
        <div class="flash <%= kind %>" role="status"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer <%= "site-footer--home" if current_page?(root_path) %>">
      <%= pixel_tip_jar %>
    </footer>
  </body>
</html>

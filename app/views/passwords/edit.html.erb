<section class="auth-card"><h1>New password</h1>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <%= form.label :password, "New password" %><%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    <%= form.label :password_confirmation, "Repeat new password" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    <%= form.submit "Save password", class: "button primary" %>
  <% end %>
</section>
